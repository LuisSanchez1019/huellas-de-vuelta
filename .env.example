# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase.
# No subas .env.local ni claves reales al repositorio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública del sitio. Se usa para metadataBase, canonical, Open Graph,
# sitemap.xml y robots.txt. En desarrollo puede omitirse (cae a
# http://localhost:3000). EN PRODUCCION es obligatorio fijarla al dominio real:
#   NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=

# Solo servidor (sin NEXT_PUBLIC_). Secreto que Vercel Cron envía como
# "Authorization: Bearer <CRON_SECRET>" a /api/cron/health. Generar una cadena
# larga y aleatoria y configurarla en Vercel (Production). No poner un valor real aquí.
CRON_SECRET=
